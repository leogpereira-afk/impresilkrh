# Para desenvolvimento local com a nuvem. Em produção (GitHub Pages) esses
# valores já vêm de .env.production (versionado — são públicos).
# Copie para .env para rodar `npm run dev` conectado ao Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx   # a chave "publishable/anon" (Project Settings → API Keys)
