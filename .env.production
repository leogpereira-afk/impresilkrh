# Configuração PÚBLICA do Supabase, embutida no build de produção (GitHub Pages).
#
# Estes dois valores NÃO são secretos: a "publishable/anon key" é feita para ir
# no navegador de qualquer visitante (as regras de acesso do banco — RLS — é que
# protegem os dados). Por isso podem ficar no repositório.
#
# A chave SECRETA de verdade (service_role / sb_secret_...) NUNCA entra aqui nem
# no repositório — ela só existe dentro do Supabase (Edge Functions).
VITE_SUPABASE_URL=https://heveemylixartyijxewh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_K0dOAL1xqHSv34I1O_26RQ_nPsuTQkz
